# Copy this file to .env and fill in real values. .env is gitignored.

# Service port
PORT = 8083

# LLM config
# The service uses the OpenAI starter, which works with any OpenAI-compatible
# endpoint. Switch providers by changing the three values below only.
#
# --- Google Gemini (free tier) ---
OPEN_API_KEY = REPLACE_WITH_YOUR_GEMINI_API_KEY
OPEN_API_BASE_URL = https://generativelanguage.googleapis.com/v1beta/openai
CHAT_MODEL = gemini-2.0-flash
#
# --- Ollama (local, no key needed) ---
# OPEN_API_KEY = ollama
# OPEN_API_BASE_URL = http://localhost:11434/v1
# CHAT_MODEL = qwen2.5-coder
#
# --- OpenAI ---
# OPEN_API_KEY = sk-...
# OPEN_API_BASE_URL = https://api.openai.com/v1
# CHAT_MODEL = gpt-4o-mini

# Eureka service registry
SERVER_URL = http://localhost:8761/eureka

# JDBC Postgres
DB_URL = jdbc:postgresql://localhost:5432/ai_engineering
DB_USERNAME = your_db_user
DB_PASSWORD = your_db_password
