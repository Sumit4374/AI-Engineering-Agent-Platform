# Copy to `.env` (git-ignored) and fill in real values.

# Port this service listens on
PORT=8085

# Eureka registry URL (same as the other services)
SERVER_URL=http://localhost:8761/eureka

# Postgres — point at the rag_db database on the shared instance.
# The database must have the `vector` extension available (pgvector image).
DB_URL=jdbc:postgresql://localhost:5432/rag_db
DB_USERNAME=platform
DB_PASSWORD=platform

# --- Embedding backend ------------------------------------------------------
# Default is OpenAI text-embedding-3-small (1536 dims). Set a real key:
EMBEDDING_API_KEY=sk-your-openai-key

# Optional overrides — uncomment to run embeddings on a local Ollama instead
# (no API cost, but higher device load). Requires `ollama pull nomic-embed-text`
# AND changing spring.ai.vectorstore.pgvector.dimensions=768 in
# application.properties (the vector column width is fixed at table creation).
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
