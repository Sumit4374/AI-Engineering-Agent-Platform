# Copy to `.env` and fill in real values. `.env` is git-ignored.

# Port this service listens on
PORT=8084

# Eureka registry URL (same as the other services)
SERVER_URL=http://localhost:8761/eureka

# JWT signing secret — MUST be byte-for-byte identical to auth_service's
# JWT_SECRET, otherwise tokens issued by auth_service will fail validation here.
JWT_SECRET=change-me-to-match-auth-service
