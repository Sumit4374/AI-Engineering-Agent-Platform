# ============================================================
# AI Engineering Agent Platform — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your local or production values.
# ============================================================

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/ai_engineering_db
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------
# Secret key for HMAC SHA-256 signing (must be at least 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long_12345
# Token expiration in milliseconds (default: 3600000 = 1 hour, 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------
# AI Model Provider Configuration
# ------------------------------------------------------------
# Active provider: NVIDIA_NIM | OPENAI | OLLAMA
AI_PROVIDER=NVIDIA_NIM

# NVIDIA NIM / OpenAI Compatible API Configuration
OPEN_API_KEY=nvapi-your-nvidia-nim-api-key-here
OPEN_API_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_MODEL=meta/llama-3.1-70b-instruct

# Optional Direct OpenAI API Key (if AI_PROVIDER=OPENAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional Ollama Base URL (if AI_PROVIDER=OLLAMA)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Chat memory JDBC schema initialization (always | never)
CHAT_MEMORY_INIT_SCHEMA=never

# ------------------------------------------------------------
# Kafka — Event-Driven Architecture (Optional)
# ------------------------------------------------------------
# Set to true to publish/consume events from a Kafka broker
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------
# MCP & Workspace Security
# ------------------------------------------------------------
# Root directory for filesystem tools confinement (default: current directory .)
MCP_WORKSPACE_ROOT=.
# Maximum file read limit in bytes (default: 262144 = 256 KB)
MCP_MAX_READ_BYTES=262144
# Maximum directory tree recursion depth (default: 5)
MCP_MAX_TREE_DEPTH=5